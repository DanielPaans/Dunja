# Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=your-existing-secret

# Choose your own administrator email.
ADMIN_EMAIL=your-google-email@gmail.com

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

GOOGLE_REDIRECT_URI=https://your-domain.nl/api/auth/google/callback

# Keep true when the site is reached over HTTPS (for example through Cloudflare Tunnel).
COOKIE_SECURE=true